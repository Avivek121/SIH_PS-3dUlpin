# 3D ULPIN Backend Environment
ENVIRONMENT=development
DEMO_MODE=true

# JWT
JWT_SECRET_KEY=dev-secret-key-change-in-production-3dulpin-2026
JWT_REFRESH_SECRET_KEY=dev-refresh-secret-key-change-in-production-3dulpin-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL + PostGIS
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=vivekkumar
POSTGRES_PASSWORD=
POSTGRES_DB=ulpin3d

# Google OAuth (leave empty for demo mode)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Sign In (leave empty for demo mode)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# SMS Provider (leave empty for demo mode)
SMS_PROVIDER=demo
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Server
HOST=0.0.0.0
PORT=8000
